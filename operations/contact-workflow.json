        "emailType": "text",
        "message": "={{ \"Neue Kontaktanfrage über boesger.com\\n\\nName: \" + ($json.name || \"nicht angegeben\") + \"\\nE-Mail: \" + $json.email + \"\\n\\n\" + $json.message }}",
        "options": {
