          },
          "conditions": [
            {
              "id": "7dd07b4d-7ab7-48dd-a9b5-19b99e393bdf",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
