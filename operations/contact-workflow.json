    {
      "id": "888d936e-c4ea-461f-a0b1-fe65442c79bf",
      "name": "Expire abuse data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const state = $getWorkflowStaticData('global'); state.window = (state.window || []).filter(x => x.at > Date.now() - 15 * 60 * 1000); return [];"
      }
    },
    {
      "id": "4da04a8b-de0b-40f1-9a18-051e3fae7627",
      "name": "Contact POST",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "boesger-contact-v1",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "1f57e8ef-baec-4a67-a83a-8d39d393bbee"
    },
    {
      "id": "45987460-bce1-4fb5-8a53-f6bf77d7d850",
      "name": "Validate and limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst body = item.body || {};\nconst headers = item.headers || {};\nconst origin = String(headers.origin || '');\nconst name = String(body.name || '').trim();\nconst email = String(body.email || '').trim();\nconst message = String(body.message || '').trim();\nconst forbidden = /[\\r\\n\\x00]/;\nlet valid = ['https://boesger.com','https://polarion.boesger.com'].includes(origin);\nvalid &&= !String(body.website || '').trim();\nvalid &&= name.length <= 120 && !forbidden.test(name);\nvalid &&= email.length <= 254 && /^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$/.test(email) && !forbidden.test(email);\nvalid &&= message.length >= 10 && message.length <= 5000 && !message.includes('\\x00');\nconst state = $getWorkflowStaticData('global');\nconst now = Date.now();\n// Only a short, per-IP anti-spam window. No messages or email addresses in static data.\nstate.window = (state.window || []).filter(x => x.at > now - 15 * 60 * 1000);\nconst ip = String(headers['cf-connecting-ip'] || '').slice(0,64);\nif (!ip) valid = false;\nif (state.window.length >= 100 || state.window.filter(x => x.ip === ip).length >= 3) valid = false;\nif (valid) state.window.push({ip,at:now});\nreturn [{json:{valid,name,email,message}}];\n"
      }
    },
    {
      "id": "34c0d256-c6e9-4ec8-b7e9-423c57d96e95",
      "name": "Valid request",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
